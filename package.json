{
  "name": "gstack",
  "version": "0.0.0",
  "private": true,
  "description": "Schema-first application framework",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "cli",
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run test:architecture && npm run test:cli && node scripts/version-sync.mjs && node scripts/release-audit.mjs --strict && node scripts/compatibility-baseline.mjs",
    "compatibility:check": "npm run build && node scripts/compatibility-baseline.mjs",
    "compatibility:print": "npm run build && node scripts/compatibility-baseline.mjs --print",
    "compatibility:update": "npm run build && node scripts/compatibility-baseline.mjs --write",
    "clean": "tsc -b --clean",
    "format": "prettier --write \"**/*.{ts,js,mjs,json,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,js,mjs,json,yaml,yml}\"",
    "lint": "eslint .",
    "mcp": "node packages/mcp/dist/main.js",
    "release:audit": "npm run build && node scripts/release-audit.mjs",
    "release:check": "npm run build && node scripts/release-audit.mjs --strict",
    "release:smoke": "npm run build && node scripts/release-smoke.mjs",
    "test": "vitest run",
    "test:architecture": "node --test tests/architecture.test.mjs",
    "test:cli": "npm run build && node --test tests/cli-contract.test.mjs",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty false && tsc -p tsconfig.test.json --noEmit --pretty false",
    "version:check": "npm run build && node scripts/version-sync.mjs",
    "version:set": "node scripts/version-sync.mjs --set"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.1",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  }
}
